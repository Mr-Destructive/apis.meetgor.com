{
  "name": "apis.meetgor.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:specs": "node scripts/build-specs.mjs",
    "dev": "npm run build:specs && wrangler dev",
    "deploy": "npm run build:specs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint:specs": "npx @stoplight/spectral-cli lint specs/*.yaml --fail-severity=warn"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "js-yaml": "^4.2.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.107.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  }
}
